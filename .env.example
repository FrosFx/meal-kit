# Postgres connection string (Neon). Required.
DATABASE_URL=

# Admin panel password (server only, never NEXT_PUBLIC_). Required for admin login.
ADMIN_PASSWORD=

# Secret for signing the admin session cookie, at least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it (or ADMIN_PASSWORD) logs out every admin session.
ADMIN_SESSION_SECRET=

# Legacy: present in old .env files, not used by the code. Can be removed.
ADMIN_PANEL=

# Public absolute site URL without trailing slash, e.g. https://kutijaobroka.rs
# Used for sitemap.xml, robots.txt and metadataBase. Optional on Vercel
# (falls back to VERCEL_PROJECT_PRODUCTION_URL), defaults to http://localhost:3000.
SITE_URL=
