// Prisma šema za meal-kit prototip.
// Učimo se ovde: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Recipe {
  id              String   @id @default(cuid())
  name            String
  description     String
  emoji           String
  color           String
  // Tagovi su sačuvani kao JSON string (npr. ["brzo","vegetarijansko"]) radi
  // jednostavnosti -- parsiraju se u aplikaciji (videti lib/recipeSerialization.ts).
  tags            String
  prepMinutes     Int
  calories        Int
  pricePerServing Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
